# ============================================================
# ROYALE EXPERIENCE GLOBAL CONCEPT (REGC) — Environment config
# Copy this file to .env and fill in your real values.
# NEVER commit the .env file (it contains secrets).
# ============================================================

# --- Core ---
APP_NAME="Royale Experience Global Concept"
APP_TAGLINE="Premium Foodstuff Delivery"
# Your public base URL (no trailing slash). Used for canonical URLs, OG,
# sitemap, Rivo redirects and the webhook URL.
APP_BASE_URL="http://localhost/regc"

# --- Debug ---
# Set to 1 ONLY to diagnose an error (e.g. HTTP 500): it shows PHP errors on
# screen. Leave 0 in production — errors are still written to logs/php-error.log.
APP_DEBUG=0

# --- Supabase (database + REST API) ---
# Project Settings -> API
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_ANON_KEY="YOUR-ANON-KEY"
# Service role key: SERVER-SIDE ONLY. Never expose in the browser.
SUPABASE_SERVICE_KEY="YOUR-SERVICE-ROLE-KEY"

# --- Admin ---
# Temporary admin password used only until you set a real one in
# Admin -> Settings -> Admin Account.
DEFAULT_ADMIN_PASSWORD="change-me-now"

# --- GitHub webhook deploy (/wh) ---
# Must match the "Secret" you configure in the GitHub webhook settings.
WEBHOOK_SECRET="rayyan"

# --- Cloudinary (product images + site assets) ---
# Format: cloudinary://api_key:api_secret@cloud_name
# Enables product image uploads in the admin and serves favicon/OG/hero
# images from the Cloudinary CDN. Leave empty to keep using local files.
CLOUDINARY_URL=""

# --- SEO / brand ---
APP_DESCRIPTION="Premium foodstuff delivery you can trust. Fresh produce, pantry essentials, quality oils and exclusive Ramadan food packs — we shop, we pack, we deliver, you relax."
# Comma-separated, e.g. "rice,beans,garri,foodstuff,fresh produce"
APP_KEYWORDS="foodstuff, foodstuff delivery, fresh produce, pantry essentials, rice, beans, garri, palm oil, Ramadan food packs, gift hampers, groceries, Nigeria, REGC"
# Social/share image (absolute or root-relative path)
APP_OG_IMAGE="/assets/og-image.jpg"
APP_TWITTER_HANDLE="@regc_ng"
# Organization identity for JSON-LD
ORG_NAME="Royale Experience Global Concept"
ORG_EMAIL="hello@royaleexperience.com.ng"
ORG_PHONE="+2348166978348"
ORG_ADDRESS="Lagos, Nigeria"
ORG_FOUNDED="2024"

# --- Optional: site verification ---
# GOOGLE_SITE_VERIFICATION=""
# BING_SITE_VERIFICATION=""